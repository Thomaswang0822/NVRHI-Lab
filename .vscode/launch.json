{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NVRHI-Lab (D3D12)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["--backend=d3d12"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "NVRHI-Lab (Vulkan)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["--backend=vulkan"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "NVRHI-Lab (D3D11)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["--backend=d3d11"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "NVRHI-Lab (Vulkan, 300-frame smoke)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["--backend=vulkan", "--frameNum=300"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        }
    ]
}
